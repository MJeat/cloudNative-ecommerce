# Keep your real MONGO_URL, COMMERCE_MONGO_URL, and JWT_SECRET in a local
# .env file. Do not commit credentials to this example file.
#
# The current private EC2 addresses supplied for the four-instance layout:
NGINX_PRIVATE_IP=172.31.22.255
GATEWAY_A_PRIVATE_IP=172.31.37.82
GATEWAY_B_PRIVATE_IP=172.31.35.83
BACKEND_PRIVATE_IP=172.31.43.132

MONGO_URL=REPLACE_WITH_YOUR_EXISTING_MONGO_URL
COMMERCE_MONGO_URL=REPLACE_WITH_YOUR_EXISTING_COMMERCE_MONGO_URL
JWT_SECRET=REPLACE_WITH_YOUR_EXISTING_JWT_SECRET
GATEWAY_PORT=5011
